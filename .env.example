# From https://developer.spotify.com/dashboard (your app > Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match the redirect URI saved in your Spotify app exactly. It defaults to
# http://127.0.0.1:<PORT>/callback; Spotify rejects "localhost", so keep 127.0.0.1.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional fallback for songs ReccoBeats doesn't know.
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# PORT=8888
